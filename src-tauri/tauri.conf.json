{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenaPad",
  "version": "1.0.0",
  "identifier": "com.ricardopena.penapad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PenaPad",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 20 },
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": { "windowSize": { "width": 600, "height": 380 } }
    },
    "fileAssociations": [
      {
        "ext": ["txt", "md", "js", "ts", "tsx", "jsx", "json", "py", "html", "css", "sql", "c", "cpp", "h", "xml", "sh", "yml", "yaml", "log", "ini", "conf"],
        "name": "Text Document",
        "role": "Editor"
      }
    ]
  }
}
