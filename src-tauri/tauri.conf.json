{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PenaPad",
  "version": "1.2.1",
  "identifier": "com.ricardopena.penapad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PenaPad",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "js",
          "ts",
          "tsx",
          "jsx",
          "json",
          "py",
          "html",
          "css",
          "sql",
          "c",
          "cpp",
          "h",
          "xml",
          "sh",
          "yml",
          "yaml",
          "log",
          "ini",
          "conf"
        ],
        "name": "Text Document",
        "role": "Editor"
      }
    ],
    "shortDescription": "Editor de texto e código leve",
    "longDescription": "Editor de texto e código leve, no espírito do Notepad++: abas, tela dividida, comparação de textos, histórico de versões local e nada se perde ao fechar.",
    "publisher": "Ricardo Pena",
    "copyright": "© 2026 Ricardo Pena",
    "homepage": "https://github.com/RicardoPenaDev/PenaPad",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "section": "editors",
        "desktopTemplate": "linux/penapad.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/penapad.desktop"
      },
      "appimage": {}
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1RjY1MDAyODI3Q0E4NjAKUldSZ3FIeUNBbEQyWmJlNXpvMDZ3K0M1SEdSQlJYbzdUa2F2T2dMajVtclFxakd4d2V5aUlad1QK",
      "endpoints": [
        "https://github.com/RicardoPenaDev/PenaPad/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
